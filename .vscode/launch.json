{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Run FastAPI",
            "type": "python",
            "request": "launch",
            "program": "uvicorn",
            "args": [
                "main:app",
                "--reload"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Run FastAPI OPE_DBSQLite",
            "type": "python",
            "request": "launch",
            "program": "uvicorn",
            "args": [
                "OPE_DBSQLite.api:app",
                "--reload"
            ],
            "console": "integratedTerminal"
        }
    ]
}